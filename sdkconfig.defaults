# ESP32-S3 AI Robot defaults
CONFIG_IDF_TARGET="esp32s3"

# Waveshare ESP32-S3-Touch-LCD-3.49 V2: 16 MB flash + 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Reserve two 5 MB application slots from the beginning so future OTA does
# not require repartitioning a deployed device.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# LVGL/FreeRTOS timing used by the board runtime.
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_OS_FREERTOS=y

# Fonts currently used by the project UI.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_SIMSUN_16_CJK=y

# BLE central / scanner used by the Settings Bluetooth page.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y

# Keep NimBLE host allocations out of scarce internal DRAM. The BT controller
# and HCI transport still use internal memory; host buffers go to 8 MB PSRAM.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# ESP32-S3 has one 2.4 GHz RF shared by Wi-Fi and BLE. Enable Espressif's
# software coexistence scheduler because this product keeps Wi-Fi connected
# while the Settings page performs BLE active scans.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# TF-card config.json uses a FAT long filename (more than 3 extension chars).
# Keep LFN buffers on the heap to avoid consuming small task stacks.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# ESP-SR WakeNet10: package the official Hey Buddy offline wake word.
# ESP-SR 2.5.5 is required; run idf.py reconfigure after pulling.
CONFIG_SR_WN_WN9_HIESP=n
CONFIG_SR_WN_WN10_EN_HEYBUDDY=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y
CONFIG_MODEL_IN_FLASH=y

# External-RAM-first policy for non-DMA Wi-Fi/LwIP allocations.
# Retain internal RAM for controller, DMA, task stacks and audio callbacks.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Runtime voice + UI needs usable heap, not Wi-Fi IRAM fast paths.
# ESP-IDF may require reconfiguration of an existing local sdkconfig.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# LVGL v9: replace 64 KiB internal static TLSF pool with a PSRAM-only
# heap_caps allocator. Implementations live in components/board/board.c.
# Preserve all LVGL widgets, themes, fonts, touch and 640x172 geometry.
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CUSTOM_MALLOC=y
