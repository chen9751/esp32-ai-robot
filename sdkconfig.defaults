# ESP32-S3 AI Robot defaults
CONFIG_IDF_TARGET="esp32s3"

# Waveshare ESP32-S3-Touch-LCD-3.49 V2: 16 MB flash + 8 MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Reserve two 5 MB application slots from the beginning so future OTA does
# not require repartitioning a deployed device.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# LVGL/FreeRTOS timing used by the board runtime.
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_OS_FREERTOS=y

# Fonts currently used by the project UI.
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_SIMSUN_16_CJK=y
